# ==========================================
# CATCH-ALL: Force all files & formats to be detectable
# ==========================================
* linguist-detectable=true
* -linguist-documentation
* -linguist-vendored

# ==========================================
# DOCUMENTS & MARKUP
# ==========================================
*.md linguist-detectable=true
*.md -linguist-documentation
*.markdown linguist-detectable=true
*.markdown -linguist-documentation
*.txt linguist-detectable=true
*.txt -linguist-documentation
*.pdf linguist-detectable=true
*.pdf -linguist-documentation
*.doc linguist-detectable=true
*.docx linguist-detectable=true
*.rtf linguist-detectable=true

# ==========================================
# DATA & CONFIG FILES
# ==========================================
*.json linguist-detectable=true
*.json -linguist-documentation
*.yaml linguist-detectable=true
*.yaml -linguist-documentation
*.yml linguist-detectable=true
*.yml -linguist-documentation
*.xml linguist-detectable=true
*.xml -linguist-documentation
*.csv linguist-detectable=true
*.tsv linguist-detectable=true

# ==========================================
# VECTOR & 3D MEDIA (Natively Tracked)
# ==========================================
*.svg linguist-detectable=true
*.svg -linguist-documentation
*.svg linguist-language=SVG
*.gltf linguist-detectable=true
*.gltf -linguist-documentation

# ==========================================
# RASTER IMAGES (Mapped to XML for Indexing)
# ==========================================
*.png linguist-detectable=true
*.png -linguist-documentation
*.png linguist-language=XML

*.jpg linguist-detectable=true
*.jpg -linguist-documentation
*.jpg linguist-language=XML

*.jpeg linguist-detectable=true
*.jpeg -linguist-documentation
*.jpeg linguist-language=XML

*.gif linguist-detectable=true
*.gif -linguist-documentation
*.gif linguist-language=XML

*.webp linguist-detectable=true
*.webp -linguist-documentation
*.webp linguist-language=XML

# ==========================================
# VIDEO & AUDIO MEDIA (Mapped to XML for Indexing)
# ==========================================
*.mp4 linguist-detectable=true
*.mp4 -linguist-documentation
*.mp4 linguist-language=XML

*.mov linguist-detectable=true
*.mov -linguist-documentation
*.mov linguist-language=XML

*.webm linguist-detectable=true
*.webm -linguist-documentation
*.webm linguist-language=XML

*.mp3 linguist-detectable=true
*.mp3 -linguist-documentation
*.mp3 linguist-language=XML

*.wav linguist-detectable=true
*.wav -linguist-documentation
*.wav linguist-language=XML
